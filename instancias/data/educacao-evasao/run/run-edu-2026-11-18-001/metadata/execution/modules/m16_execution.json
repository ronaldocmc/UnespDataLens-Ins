{
  "run_id": "run-edu-2026-11-18-001",
  "pipeline_id": "EDU-EVASAO-01",
  "module_id": "M16",
  "module_name": "Agentes Inteligentes de Apoio ao Pipeline",
  "kind": "transversal",
  "status": "SUCCESS",
  "objective": "Permitir consultas livres ou estruturadas sobre o pipeline usando somente evidências governadas e rastreáveis produzidas pelos próprios módulos.",
  "input_summary": "pergunta + artefatos/metadados/contratos/relatórios autorizados, filtrados por M10",
  "output_summary": "resposta suportada por evidências ou abstenção + evidence refs + registro da consulta",
  "inputs": [
    {
      "id": "query:text",
      "name": "pergunta",
      "kind": "query",
      "format": "TEXT",
      "path": "runtime"
    },
    {
      "id": "evidence:governed-index",
      "name": "índice governado de evidências",
      "kind": "metadata",
      "format": "JSON/TEXT",
      "path": "artifacts/** + metadata/** + contracts/** + reports/**"
    },
    {
      "id": "governance:m10",
      "name": "políticas de acesso",
      "kind": "metadata",
      "format": "JSON",
      "path": "metadata/governance/**"
    }
  ],
  "outputs": [
    {
      "id": "agent:answer",
      "name": "resposta fundamentada",
      "kind": "runtime",
      "format": "HTML/JSON",
      "path": "runtime"
    },
    {
      "id": "agent:evidence",
      "name": "evidence refs",
      "kind": "metadata",
      "format": "JSON",
      "path": "runtime"
    },
    {
      "id": "agent:query-record",
      "name": "registro da consulta",
      "kind": "metadata",
      "format": "JSON",
      "path": "localStorage/export"
    },
    {
      "id": "agent:model",
      "name": "agent_model.json",
      "kind": "metadata",
      "format": "JSON",
      "path": "metadata/agents/agent_model.json"
    }
  ],
  "process_trace": [
    {
      "step": 1,
      "title": "Aplicar governança",
      "input": "escopo da execução",
      "operation": "Excluir data/**, input/** e mock/** na demonstração pública",
      "output": "artefatos autorizados",
      "registers": "access context",
      "events": [
        "EVIDENCE_FILTERED"
      ],
      "transversal": [
        "M10"
      ]
    },
    {
      "step": 2,
      "title": "Indexar",
      "input": "artefatos autorizados",
      "operation": "Segmentar conteúdo em trechos e associar path, módulo e evidence_id",
      "output": "índice dinâmico",
      "registers": "EV-AUTO-*",
      "events": [
        "EVIDENCE_INDEXED"
      ],
      "transversal": [
        "M09",
        "M11",
        "M12"
      ]
    },
    {
      "step": 3,
      "title": "Recuperar",
      "input": "pergunta livre",
      "operation": "Pontuar relevância lexical + metadados + sinônimos",
      "output": "até 6 evidências",
      "registers": "evidence_ids + scores",
      "events": [
        "EVIDENCE_RETRIEVED"
      ],
      "transversal": [
        "M11",
        "M12"
      ]
    },
    {
      "step": 4,
      "title": "Responder",
      "input": "evidências recuperadas",
      "operation": "Responder de forma estruturada ou extractiva; backend LLM é opcional e server-side",
      "output": "SUPPORTED_BY_RETRIEVAL ou INSUFFICIENT_EVIDENCE",
      "registers": "answer_status",
      "events": [
        "AGENT_QUERY_COMPLETED"
      ],
      "transversal": [
        "M10",
        "M15"
      ]
    },
    {
      "step": 5,
      "title": "Registrar",
      "input": "pergunta + evidências + resposta",
      "operation": "Persistir localmente e permitir exportação JSON",
      "output": "query record",
      "registers": "query_id + evidence paths + mode",
      "events": [
        "QUERY_LOGGED"
      ],
      "transversal": [
        "M09"
      ]
    }
  ],
  "metrics": [
    {
      "label": "Índice",
      "value": "dinâmico"
    },
    {
      "label": "Máx. evidências",
      "value": "6"
    },
    {
      "label": "Dados brutos",
      "value": "bloqueados"
    },
    {
      "label": "LLM",
      "value": "backend opcional"
    }
  ],
  "contract_ref": "contracts/m16_contract.json",
  "provenance_records": [
    {
      "query_id": "Q-001",
      "question": "Qual foi a qualidade do dataset usado no indicador de evasão?",
      "evidence_ids": [
        "EV-M05-QUALITY",
        "EV-M07-ASSET",
        "EV-M11-LINEAGE",
        "EV-M12-MANIFEST"
      ],
      "answer_status": "SUPPORTED_BY_EVIDENCE"
    },
    {
      "query_id": "Q-LOCAL-*",
      "question": "pergunta livre",
      "evidence_ids": [
        "EV-AUTO-*"
      ],
      "answer_status": "SUPPORTED_BY_RETRIEVAL | INSUFFICIENT_EVIDENCE"
    }
  ],
  "transversal_interactions": [
    {
      "id": "M10",
      "action": "Filtra o que pode ser indexado e consultado."
    },
    {
      "id": "M11",
      "action": "Fornece lineage e proveniência para explicar origem e impacto."
    },
    {
      "id": "M12",
      "action": "Fornece versão, commit e contexto reprodutível."
    },
    {
      "id": "M15",
      "action": "Fornece estado corrente, drift e alertas."
    }
  ]
}